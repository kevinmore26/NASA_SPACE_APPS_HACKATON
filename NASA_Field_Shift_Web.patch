diff --git a/apps/field_shift/lib/runtime/browser_store.dart b/apps/field_shift/lib/runtime/browser_store.dart
new file mode 100644
--- /dev/null
+++ b/apps/field_shift/lib/runtime/browser_store.dart
@@ -0,0 +1,103 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:js_interop';
+
+import 'package:field_core/field_core.dart';
+import 'package:web/web.dart' as web;
+
+class BrowserStore implements ParcelRepository, LocalDocuments {
+  static const _parcels = 'parcels';
+  static const _documents = 'documents';
+
+  BrowserStore._(this._database);
+
+  final web.IDBDatabase _database;
+
+  static Future<BrowserStore> open() {
+    final ready = Completer<BrowserStore>();
+    final request = web.window.indexedDB.open('nasa-field-shift', 1);
+    request.onupgradeneeded = ((web.Event _) {
+      final database = request.result as web.IDBDatabase;
+      database.createObjectStore(_parcels);
+      database.createObjectStore(_documents);
+    }).toJS;
+    request.onsuccess = ((web.Event _) {
+      final database = request.result as web.IDBDatabase;
+      database.onversionchange = ((web.Event _) => database.close()).toJS;
+      ready.complete(BrowserStore._(database));
+    }).toJS;
+    request.onerror = ((web.Event _) {
+      ready.completeError(StateError('Could not open browser storage.'));
+    }).toJS;
+    return ready.future;
+  }
+
+  Future<JSAny?> _request(
+    String collection,
+    String mode,
+    web.IDBRequest Function(web.IDBObjectStore) run,
+  ) {
+    final tx = _database.transaction(collection.toJS, mode);
+    final request = run(tx.objectStore(collection));
+    final done = Completer<JSAny?>();
+    tx.oncomplete = ((web.Event _) => done.complete(request.result)).toJS;
+    tx.onabort = ((web.Event _) {
+      done.completeError(
+        StateError(tx.error?.message ?? 'Could not access browser storage.'),
+      );
+    }).toJS;
+    return done.future;
+  }
+
+  Map<String, dynamic> _decode(JSAny? value) =>
+      jsonDecode((value as JSString).toDart) as Map<String, dynamic>;
+
+  List<Map<String, dynamic>> _decodeList(JSAny? value) =>
+      (value as JSArray<JSString>).toDart.map(_decode).toList();
+
+  @override
+  Future<List<Parcel>> listParcels() async => _decodeList(
+    await _request(_parcels, 'readonly', (store) => store.getAll()),
+  ).map(Parcel.fromJson).toList();
+
+  @override
+  Future<void> saveParcel(Parcel parcel) async {
+    await _request(
+      _parcels,
+      'readwrite',
+      (store) => store.put(jsonEncode(parcel.toJson()).toJS, parcel.id.toJS),
+    );
+  }
+
+  @override
+  Future<void> deleteParcel(String id) async {
+    await _request(_parcels, 'readwrite', (store) => store.delete(id.toJS));
+  }
+
+  @override
+  Future<Map<String, dynamic>?> readDocument(String key) async {
+    final value = await _request(
+      _documents,
+      'readonly',
+      (store) => store.get(key.toJS),
+    );
+    return value == null ? null : _decode(value);
+  }
+
+  @override
+  Future<void> writeDocument(String key, Map<String, dynamic> value) async {
+    await _request(
+      _documents,
+      'readwrite',
+      (store) => store.put(jsonEncode(value).toJS, key.toJS),
+    );
+  }
+
+  @override
+  Future<List<Map<String, dynamic>>> listDocuments(String prefix) async {
+    final range = web.IDBKeyRange.bound(prefix.toJS, '$prefix\uffff'.toJS);
+    return _decodeList(
+      await _request(_documents, 'readonly', (store) => store.getAll(range)),
+    );
+  }
+}
diff --git a/apps/field_shift/lib/runtime/open_browser.dart b/apps/field_shift/lib/runtime/open_browser.dart
new file mode 100644
--- /dev/null
+++ b/apps/field_shift/lib/runtime/open_browser.dart
@@ -0,0 +1,59 @@
+import 'package:field_imagery/field_imagery.dart';
+import 'package:field_nasa/field_nasa.dart';
+import 'package:http/http.dart' as http;
+
+import '../app.dart';
+import '../application/field_controller.dart';
+import 'browser_store.dart';
+import 'remote_raster_processor.dart';
+
+Future<FieldShiftApp> openFieldShift() async {
+  const configuredApi = String.fromEnvironment('FIELD_SHIFT_API_URL');
+  final api = Uri.base.resolve(configuredApi);
+  final store = await BrowserStore.open();
+  final client = http.Client();
+  final processor = RemoteRasterProcessor(client, api);
+  final model = FieldController(
+    parcels: store,
+    documents: store,
+    sentinel: StacCatalog.sentinel(
+      client,
+      endpoint: api.resolve('/api/catalog/sentinel'),
+    ),
+    landsat: landsatCatalog(
+      client,
+      endpoint: api.resolve('/api/catalog/landsat'),
+    ),
+    climate: NasaPower(client, endpoint: api.resolve('/api/weather')),
+    processor: processor,
+  );
+  await model.initialize();
+  processor.offline = model.offline;
+  model.addListener(() => processor.offline = model.offline);
+  return FieldShiftApp(
+    model: model,
+    tiles: _BrowserTiles(http.Client(), model),
+    dataDirectory: null,
+  );
+}
+
+class _BrowserTiles extends http.BaseClient {
+  _BrowserTiles(this.client, this.model);
+
+  final http.Client client;
+  final FieldController model;
+
+  @override
+  Future<http.StreamedResponse> send(http.BaseRequest request) {
+    if (model.offline) {
+      throw http.ClientException('Map tiles require an internet connection.');
+    }
+    return client.send(request);
+  }
+
+  @override
+  void close() {
+    client.close();
+    super.close();
+  }
+}
diff --git a/apps/field_shift/lib/runtime/open_native.dart b/apps/field_shift/lib/runtime/open_native.dart
new file mode 100644
--- /dev/null
+++ b/apps/field_shift/lib/runtime/open_native.dart
@@ -0,0 +1,65 @@
+import 'dart:io';
+
+import 'package:field_compute/field_compute.dart';
+import 'package:field_imagery/field_imagery.dart';
+import 'package:field_nasa/field_nasa.dart';
+import 'package:field_storage/field_storage.dart';
+import 'package:http/http.dart' as http;
+import 'package:path/path.dart' as p;
+import 'package:path_provider/path_provider.dart';
+
+import '../app.dart';
+import '../application/field_controller.dart';
+
+Future<FieldShiftApp> openFieldShift() async {
+  final support = await getApplicationSupportDirectory();
+  await support.create(recursive: true);
+  final store = await LocalStore.open(
+    p.join(support.path, 'field_shift.sqlite'),
+  );
+  final tiles = CachedTileClient(Directory(p.join(support.path, 'tiles')));
+  final client = http.Client();
+  var executable = p.join(
+    p.dirname(Platform.resolvedExecutable),
+    'workers',
+    'raster_worker',
+    'raster_worker.exe',
+  );
+  var arguments = <String>[];
+  if (!File(executable).existsSync()) {
+    var directory = Directory.current;
+    for (var i = 0; i < 8; i++) {
+      final script = File(
+        p.join(
+          directory.path,
+          'packages',
+          'field_compute',
+          'worker',
+          'raster_worker.py',
+        ),
+      );
+      if (script.existsSync()) {
+        executable = p.join(directory.path, '.venv', 'Scripts', 'python.exe');
+        arguments = [script.path];
+        break;
+      }
+      directory = directory.parent;
+    }
+  }
+  final model = FieldController(
+    parcels: store,
+    documents: store,
+    sentinel: StacCatalog.sentinel(client),
+    landsat: landsatCatalog(client),
+    climate: NasaPower(client),
+    processor: LocalRasterProcessor(
+      executable: executable,
+      arguments: arguments,
+      outputDirectory: p.join(support.path, 'results'),
+    ),
+  );
+  await model.initialize();
+  tiles.offline = model.offline;
+  model.addListener(() => tiles.offline = model.offline);
+  return FieldShiftApp(model: model, tiles: tiles, dataDirectory: support.path);
+}
diff --git a/apps/field_shift/lib/runtime/remote_raster_processor.dart b/apps/field_shift/lib/runtime/remote_raster_processor.dart
new file mode 100644
--- /dev/null
+++ b/apps/field_shift/lib/runtime/remote_raster_processor.dart
@@ -0,0 +1,103 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:field_core/field_core.dart';
+import 'package:field_imagery/field_imagery.dart';
+import 'package:http/http.dart' as http;
+
+/// HTTP transport for browser and mobile apps. The server runs the same worker
+/// used by the desktop app.
+class RemoteRasterProcessor implements RasterProcessor {
+  RemoteRasterProcessor(this.client, this.api);
+
+  final http.Client client;
+  final Uri api;
+  Completer<void>? _abort;
+  bool offline = false;
+
+  Future<Map<String, dynamic>> _post(
+    String route,
+    Map<String, dynamic> body,
+  ) async {
+    if (_abort != null) throw StateError('An analysis request is in progress.');
+    final abort = Completer<void>();
+    _abort = abort;
+    try {
+      final request =
+          http.AbortableRequest(
+              'POST',
+              api.resolve(route),
+              abortTrigger: abort.future,
+            )
+            ..headers['Content-Type'] = 'application/json'
+            ..body = jsonEncode(body);
+      final result = await client
+          .send(request)
+          .then(http.Response.fromStream)
+          .timeout(
+            const Duration(minutes: 4),
+            onTimeout: () {
+              cancel();
+              throw TimeoutException('The analysis service timed out.');
+            },
+          );
+      final isJson = result.headers['content-type']?.contains('json') ?? false;
+      if (!isJson) {
+        throw StateError(
+          'Analysis service unavailable (HTTP ${result.statusCode}).',
+        );
+      }
+      final data = jsonDecode(utf8.decode(result.bodyBytes));
+      if (data is! Map<String, dynamic>) {
+        throw StateError('Invalid response from the analysis service.');
+      }
+      if (result.statusCode != 200) {
+        throw StateError(
+          data['detail'] is String
+              ? data['detail'] as String
+              : 'Analysis service unavailable (HTTP ${result.statusCode}).',
+        );
+      }
+      return data;
+    } finally {
+      _abort = null;
+    }
+  }
+
+  @override
+  Future<RasterResult> process({
+    required Scene scene,
+    required Parcel parcel,
+    required Observation observation,
+  }) async => RasterResult(
+    await _post('/api/raster', {
+      'collection': scene.collection,
+      'sceneId': scene.id,
+      'parcelId': parcel.id,
+      'geometry': parcel.geometry.toJson(),
+      'observation': observation.name,
+    }),
+  );
+
+  @override
+  Future<PixelSample> sample(RasterResult result, GeoPoint point) async {
+    if (offline) {
+      return PixelSample.fromJson({
+        'values': null,
+        'reason': 'Connect to inspect a pixel in this observation.',
+      });
+    }
+    return PixelSample.fromJson(
+      await _post('/api/raster/${result.id}/sample', {
+        'longitude': point.longitude,
+        'latitude': point.latitude,
+      }),
+    );
+  }
+
+  @override
+  void cancel() {
+    final abort = _abort;
+    if (abort != null && !abort.isCompleted) abort.complete();
+  }
+}
